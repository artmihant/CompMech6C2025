    "        u: массив положений\n",
    "        v: массив скоростей\n",
    "    \"\"\"\n",
    "\n",
    "    u_state = np.zeros((n_steps, 1))  # положение [x]\n",
    "    v_state = np.zeros((n_steps, 1))  # скорость [v]\n",
    "    v_half_state = np.zeros((n_steps, 1)) # скорость на полуцелом шаге\n",
    "\n",
    "    u_state[0] = [u0]\n",
    "    v_state[0] = [v0]\n",
    "\n",
    "    v_half_state[0] = v_state[0] + func_v(u_state[0], v_state[0][0]) * dt / 2\n",
    "\n",
