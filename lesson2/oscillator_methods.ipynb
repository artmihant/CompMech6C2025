    "def energy(u, v):\n",
    "    \"\"\"\n",
    "    Расчет полной энергии гармонического осциллятора\n",
    "\n",
    "    Args:\n",
    "        x: смещение, м\n",
    "        v: скорость, м/с\n",
    "\n",
